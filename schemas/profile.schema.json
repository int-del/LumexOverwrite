{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumex.local/schemas/profile.schema.json",
  "title": "Lumex compiled profile",
  "type": "object",
  "required": ["proxy-groups", "rules"],
  "properties": {
    "proxy-groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "type": {
            "enum": ["select", "url-test", "fallback", "load-balance", "relay"]
          }
        }
      }
    },
    "rules": { "type": "array", "minItems": 1 },
    "rule-providers": { "type": "object" },
    "proxy-providers": { "type": "object" }
  },
  "additionalProperties": true
}
