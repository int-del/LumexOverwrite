# Last Updated: 2026-11-06 [Stash v3.01]
# 引用链接: https://raw.githubusercontent.com/int-del/LumexOverwrite/main/IosStash/Stash.stoverride
# 加速链接: https://cdn.jsdelivr.net/gh/int-del/LumexOverwrite@main/IosStash/Stash.stoverride
# 分流同步自 PC 端 Lumex_active.js V4.25;字段以 stash.wiki 为准,适用 App Store 版 3.6+。
# 没有写入 3.7 Beta 才有的 pre-matching 与覆写参数:旧版本遇到可能加载失败。
name: "Stash v3.01"
desc: "v3.01 | 同步 PC V4.25 分流 | 测速量约为 v2.12 的十分之一 | 需要基础配置提供订阅地址"
icon: https://cdn.jsdelivr.net/gh/Orz-3/mini@master/Color/Stash.png
category: Lumex
version: "3.00"
date: "2026-11-01"

mode: rule
log-level: error
ipv6: false # 只用 IPv4;IPv6-only 节点已被下方订阅白名单排除

hosts:
  # BoundaryAI 内网服务,与 PC 一致
  pola.boundaryai.com: 192.168.1.200
  skillhub.boundaryai.cn: 192.168.1.67

# ==========================================
# DNS
# ==========================================
# 官方建议:移动设备 1~2 个上游;DoH/DoT 比 UDP 更耗资源;fake-ip 下要代理的域名本机不解析,所以国内 UDP 就够。
# 不配 fallback:文档写明它和 nameserver「同时查询」,不是冷备。v2.12 每次解析要并发 4 路 DoT。
# 所有 IP 规则都带 no-resolve(RFC-031),国外域名不会落到这里解析。
dns: #!replace
  ipv6: false
  nameserver:
    - 223.5.5.5
    - 119.29.29.29
  # 节点域名单独走 IP 直连的 DoH,运营商看不到机场域名(RFC-031,与 PC 相同)。只在连节点前偶尔解析,不影响耗电。
  proxy-server-nameserver:
    - https://223.5.5.5/dns-query
    - https://1.12.12.12/dns-query
  nameserver-policy:
    "geosite:private": system
    "+.qq.com": 119.29.29.29
    "+.bilibili.com": 119.29.29.29
    "+.taobao.com": 223.5.5.5
    "+.aliyun.com": 223.5.5.5
  fake-ip-filter:
    - "*.lan"
    - "*.local"
    - "geosite:private"
    - "stun.*"
    - "+.stun.*.*"
    - "+.stun.*.*.*"
    - "+.ntp.org"
    - "time.*.com"
    - "time.*.gov"
    - "time.*.edu.cn"
    - "time.*.apple.com"
    - "time1.cloud.tencent.com"
    - "*.bambulab.com"
    - "*.bambulab.cn"

# ==========================================
# 远程代理集
# ==========================================
# 本仓库公开,这里故意不写 url:订阅地址放在手机上的基础配置里,字典会递归合并成完整的 组合机场。
#   基础配置只需要这几行(订阅要用 Sub-Store 的 Stash 格式,Hysteria2 字段才对):
#     proxy-providers:
#       组合机场:
#         url: <订阅地址>
# filter 只用正向白名单,不用前后瞻:文档只保证正则过滤,不保证引擎支持前后瞻。白名单同时挡住:
#   - 裸 SS「自建·<机器>·SS」:不带跳板,SS2022 从手机直接过墙,台北 IP 可能被封(见 Lumex_active.js);
#   - 机场公告节点、IPv6-only 节点、×3 倍率节点、微斯主入口(2026-11-01 家宽实测 43 个只通 1 个)。
# ⚠️ 滤空时组和代理集都会变成 DIRECT(文档写明),Stash 没有 empty-fallback;机场大改名要同步这里。
proxy-providers:
  组合机场:
    interval: 21600 # 与 Sub-Store 每 6 小时同步 Gist 对齐;未变化时靠 ETag 不重新下载
    path: ./proxies/sub_store_collection.yaml
    filter: "^(悦·(🇭🇰|🇹🇼|🇯🇵|🇸🇬|🇰🇷|🇺🇸)|微斯·(🇭🇰|🇨🇳TW|🇯🇵|🇸🇬|🇰🇷|🇺🇸).*备用入口$|一分·(🇭🇰|🇯🇵|🇸🇬|🇹🇼)|自建·台北[0-9]+·Reality$)"
    # 测速参数按节点生效,多个组共享结果,所以写在这里而不是每个组(文档:组上没有 url 字段)。
    benchmark-url: http://www.gstatic.com/generate_204 # 文档建议只用 HTTP,少一次 TLS 握手
    benchmark-timeout: 5

# ==========================================
# 策略组
# ==========================================
# 省电靠三点:
#   1. url-test 只选延迟最低的,选不上的远距离节点不进组,每轮少测;
#   2. 全部 lazy: true,闲置的组不测;
#   3. 全部 interval: 600,一起测;v2.12 的 600/630/660/720 错开,等于各唤醒一次蜂窝射频。
# v3.01:悦 11 月初去掉了名字末尾的「 · A/B」,「[12] · 」改成「[12]( · |$)」,有无后缀都认。
proxy-groups: #!replace
  - name: 自动选择
    type: url-test
    icon: https://cdn.jsdelivr.net/gh/Orz-3/mini@master/Color/Urltest.png
    use:
      - 组合机场
    filter: "^(微斯·(🇭🇰|🇨🇳TW|🇯🇵|🇸🇬|🇰🇷).*备用入口$|悦·🇭🇰|悦·(🇯🇵日本|🇸🇬新加坡|🇹🇼台湾)[12]( · |$)|一分·(🇭🇰|🇯🇵日本专线|🇸🇬|🇹🇼))"
    interval: 600
    tolerance: 100
    lazy: true

  # 不收日本(与 PC 一致)和自建(VPS 流量有限);不收微斯:它延迟最低但流量有限,视频留给不限量的悦和 0.1 倍率的一分。
  - name: EMBY
    type: url-test
    icon: https://cdn.jsdelivr.net/gh/Orz-3/mini@master/Color/Emby.png
    use:
      - 组合机场
    filter: "^(悦·🇭🇰|悦·(🇰🇷韩国|🇸🇬新加坡|🇹🇼台湾)[12]( · |$)|一分·(🇭🇰|🇸🇬|🇹🇼))"
    interval: 600
    tolerance: 100
    lazy: true

  # 节点池同 EMBY,原因相同:YouTube 走 自动选择 会选中微斯,很快用完它的流量。不看视频时 lazy 不测。
  - name: YouTube
    type: url-test
    icon: https://cdn.jsdelivr.net/gh/Orz-3/mini@master/Color/YouTube.png
    use:
      - 组合机场
    filter: "^(悦·🇭🇰|悦·(🇰🇷韩国|🇸🇬新加坡|🇹🇼台湾)[12]( · |$)|一分·(🇭🇰|🇸🇬|🇹🇼))"
    interval: 600
    tolerance: 100
    lazy: true

  # Google 与 TikTok 也走本组,手机上基本一直在用,所以节点池要小。不收港澳(Gemini 不可用)和一分(与 PC 一致)。
  - name: Gemini
    type: url-test
    icon: https://cdn.jsdelivr.net/gh/Orz-3/mini@master/Color/Google.png
    use:
      - 组合机场
    filter: "^(微斯·(🇨🇳TW|🇯🇵|🇸🇬|🇺🇸).*备用入口$|悦·(🇯🇵|🇸🇬|🇺🇸)[^·]*AI解锁|悦·🇺🇸美国[12]( · |$))"
    interval: 600
    tolerance: 100
    lazy: true

  - name: ChatGPT
    type: url-test
    icon: https://cdn.jsdelivr.net/gh/Orz-3/mini@master/Color/OpenAI.png
    use:
      - 组合机场
    filter: "^(微斯·(🇨🇳TW|🇯🇵|🇸🇬|🇺🇸).*备用入口$|悦·(🇯🇵|🇸🇬|🇺🇸)[^·]*AI解锁|悦·🇺🇸美国[12]( · |$))"
    interval: 600
    tolerance: 100
    lazy: true

  # 与 PC 的 Claude 组用同一批台湾出口。手机不走中转:文档里代理集没有 override,节点的 dialer-proxy 也不能指向含代理集的组。
  - name: Claude
    type: url-test
    icon: https://www.google.com/s2/favicons?domain=claude.ai&sz=128
    use:
      - 组合机场
    filter: "^自建·台北[0-9]+·Reality$"
    interval: 600
    tolerance: 100
    lazy: true

  # 只收美国落地(PC V4.24)。Facebook / Instagram 也走本组(V4.25),保持 Meta 看到的地区一致。
  - name: Muse
    type: url-test
    icon: https://www.google.com/s2/favicons?domain=muse.ai&sz=128
    use:
      - 组合机场
    filter: "^(微斯·🇺🇸.*备用入口$|悦·🇺🇸)"
    interval: 600
    tolerance: 100
    lazy: true

  # 文档:select 也按 600 秒定时测,且递归测子组。国内流量一直命中本组,不关掉就会带着 自动选择 一起测。
  - name: 国内
    type: select
    icon: https://cdn.jsdelivr.net/gh/Orz-3/mini@master/Color/CN.png
    interval: -1
    proxies:
      - DIRECT
      - 自动选择

# ==========================================
# 规则
# ==========================================
# 落到 MATCH 的都走 自动选择,所以和它同去向的规则都不写,只写例外。
rules: #!replace
  # === 局域网(文档写法是 GEOIP,LAN;v2.12 的 GEOIP,PRIVATE 没有文档依据) ===
  - GEOIP,LAN,DIRECT,no-resolve
  - DOMAIN-SUFFIX,lan,DIRECT
  - DOMAIN-SUFFIX,local,DIRECT
  - DOMAIN-SUFFIX,home.arpa,DIRECT
  - DOMAIN-SUFFIX,boundaryai.com,DIRECT
  - DOMAIN-SUFFIX,boundaryai.cn,DIRECT

  # === 启动依赖:GEOSITE 数据首次要从 github.com 下载,订阅在 Gist,必须排在所有 GEOSITE 规则之前 ===
  - DOMAIN-SUFFIX,github.com,自动选择
  - DOMAIN-SUFFIX,githubusercontent.com,自动选择
  - DOMAIN-SUFFIX,sub.store,DIRECT

  # === 苹果:iOS 后台流量最大头。前三条保证 GEOSITE 还没加载时也直连 ===
  - DOMAIN-SUFFIX,apple.com,DIRECT
  - DOMAIN-SUFFIX,icloud.com,DIRECT
  - DOMAIN-SUFFIX,mzstatic.com,DIRECT
  - GEOSITE,apple,DIRECT

  # === Emby ===
  - DOMAIN,tv.ash.yt,EMBY # AshEmby
  - DOMAIN,ask.ash.yt,EMBY # Ask AshS
  - DOMAIN,emby.bangumi.ca,EMBY # Nyamedia:公益
  - DOMAIN,1.eoos.lol,EMBY # eoos
  - DOMAIN,v1.uhdnow.com,EMBY # UHD
  - DOMAIN,emby-cm.hohai.eu.org,EMBY # honhai:公费
  - DOMAIN,emby-npo.hohai.eu.org,EMBY # hohai:公益
  - DOMAIN,us01.doudou.pet,EMBY # Ryan:公益
  - DOMAIN-SUFFIX,startspoint.com,EMBY # 起点公费A
  - DOMAIN-SUFFIX,mobaiemby.site,EMBY # 墨云阁:公益30天保号
  - DOMAIN-SUFFIX,yue.to,EMBY # 悦:stream.yue.to
  - DOMAIN-SUFFIX,28.al,EMBY # 起点:公益2-30天保号
  # Emby 直连服
  - DOMAIN-SUFFIX,xmsl.org,DIRECT # 1111:公费
  - DOMAIN-SUFFIX,1huanlesap02.top,DIRECT # 起点:Pro
  - DOMAIN-SUFFIX,yfjc.xyz,DIRECT

  # === 自定义直连 ===
  - DOMAIN-SUFFIX,1145145.com,DIRECT
  - DOMAIN-SUFFIX,bambulab.com,DIRECT
  - DOMAIN-SUFFIX,bambulab.cn,DIRECT
  - DOMAIN-SUFFIX,bambulab.co,DIRECT
  - DOMAIN,cn.bing.com,DIRECT # 修复 Bing 重定向循环
  - DOMAIN-SUFFIX,speedtest.net,DIRECT
  - DOMAIN-SUFFIX,ookla.com,DIRECT

  # === 拦截 QUIC:只拦要走代理的。国内 QUIC 照常直连,不必被拒后再重试一次 TCP(文档示例也是先放行国内) ===
  - AND,((NETWORK,UDP),(DST-PORT,443),(NOT,((GEOSITE,cn))),(NOT,((GEOIP,CN,no-resolve)))),REJECT,no-track

  # === 广告 ===
  - GEOSITE,category-ads-all,REJECT,no-track

  # === OpenAI ===
  - DOMAIN-SUFFIX,openai.com,ChatGPT
  - DOMAIN-SUFFIX,chatgpt.com,ChatGPT
  - DOMAIN-SUFFIX,oaistatic.com,ChatGPT
  - DOMAIN-SUFFIX,oaiusercontent.com,ChatGPT
  - DOMAIN-SUFFIX,sora.com,ChatGPT
  - GEOSITE,openai,ChatGPT

  # === Anthropic(含 Intercom、Statsig,与 PC 一致);grok 也走本组 ===
  - DOMAIN-SUFFIX,anthropic.com,Claude
  - DOMAIN-SUFFIX,claude.ai,Claude
  - DOMAIN-SUFFIX,claude.com,Claude
  - DOMAIN-SUFFIX,claudeapi.com,Claude
  - DOMAIN-SUFFIX,claudeapp.com,Claude
  - DOMAIN-SUFFIX,claudepro.com,Claude
  - DOMAIN-SUFFIX,mcp.exa.ai,Claude
  - DOMAIN-SUFFIX,intercom.io,Claude
  - DOMAIN-SUFFIX,intercomassets.com,Claude
  - DOMAIN-SUFFIX,intercomcdn.com,Claude
  - DOMAIN-SUFFIX,statsig.com,Claude
  - DOMAIN-SUFFIX,statsigapi.net,Claude
  - DOMAIN-SUFFIX,grok.com,Claude

  # === Meta Muse ===
  - DOMAIN-SUFFIX,muse.ai,Muse
  - DOMAIN-SUFFIX,museai.com,Muse
  - DOMAIN-SUFFIX,meta.ai,Muse
  - DOMAIN-SUFFIX,auth.meta.com,Muse
  - DOMAIN-SUFFIX,fbcdn.net,Muse
  - DOMAIN-SUFFIX,facebook.com,Muse
  - DOMAIN-SUFFIX,instagram.com,Muse
  - DOMAIN-SUFFIX,hatch.club,Muse
  - DOMAIN-SUFFIX,ecto1.ai,Muse

  # === Google:YouTube 排在前面,免得被 GEOSITE,google 截走 ===
  - GEOSITE,youtube,YouTube
  - DOMAIN-SUFFIX,googleapis.cn,Gemini
  - DOMAIN-SUFFIX,deepmind.com,Gemini
  - DOMAIN-SUFFIX,deepmind.google,Gemini
  - GEOSITE,google,Gemini
  - GEOSITE,category-ai-chat-!cn,Gemini
  - GEOSITE,tiktok,Gemini

  # === 走到这里的 STUN 没有命中代理规则,直连保留微信、WhatsApp 等通话质量 ===
  - PROTOCOL,STUN,DIRECT
  - DST-PORT,123,DIRECT

  # === 兜底 ===
  - GEOSITE,cn,国内
  - GEOIP,CN,国内,no-resolve
  - MATCH,自动选择
